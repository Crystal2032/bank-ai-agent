HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
RP_ID=localhost
# Enable only when running the bundled Android client.
# ANDROID_CLIENT_ORIGIN=https://localhost
# Native Passkeys also require a real RP domain and Digital Asset Links.
# ANDROID_CERT_SHA256=
COOKIE_SECURE=false
# Enable one trusted hop only behind an isolated, header-replacing reverse proxy.
TRUST_PROXY_HOPS=0
DATABASE_PATH=.data/bank.sqlite
# Generate local synthetic credentials using pnpm setup:demo.
AUTH_SECRET=
DEMO_PASSWORD=
# API-only inference. Use an OpenAI-compatible chat-completions endpoint.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-flash
MODEL_API_KEY=
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_MS=30000
# disabled fails closed; file writes synthetic SMS to an ignored local outbox.
SMS_MODE=disabled
SMS_OUTBOX_PATH=.data/sms-outbox.jsonl
RECOVERY_HOLD_MS=86400000
