{
  "name": "bank-ai-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "setup:demo": "node scripts/setup-demo.mjs",
    "start:android": "node --env-file=.env scripts/start-android-backend.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@simplewebauthn/server": "14.0.3",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.5",
    "otpauth": "9.5.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
